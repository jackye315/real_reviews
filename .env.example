# Copy this file to .env and fill in local secrets.
# Never commit .env.

# Frontend/browser Google key. Restrict by HTTP referrer and required APIs.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_API_BASE_URL=
# Reviewer context is enabled by default only in development Compose.
VITE_REVIEWER_CONTEXT_ENABLED=true

# Backend/server Google key. Restrict to server-side Places APIs.
GOOGLE_MAPS_SERVER_API_KEY=
SERPAPI_API_KEY=

SERPAPI_DEFAULT_REVIEW_LIMIT=50
SERPAPI_REVIEW_SORT=qualityScore
SERPAPI_LANGUAGE=en
SERPAPI_MONTHLY_REQUEST_BUDGET=225
SERPAPI_MAX_CONCURRENCY=2
SERPAPI_ACCOUNT_SNAPSHOT_TTL_SECONDS=60
# Optional local safety ceiling. Leave blank to use the Account API hourly limit only.
PROVIDER_HOURLY_REQUEST_LIMIT=
PROVIDER_RESERVATION_LEASE_SECONDS=600
REFRESH_KNOWN_STREAK_LIMIT=10
# Private reviewer-history feature. Production defaults to false unless explicitly enabled.
REVIEWER_CONTEXT_ENABLED=true
REVIEWER_CONTEXT_STALE_AFTER_DAYS=30

# Explicit, independently metered Google Place Details review summary. Keep disabled until terms/attribution review.
GOOGLE_REVIEW_SUMMARY_ENABLED=false
GOOGLE_REVIEW_SUMMARY_MONTHLY_REQUEST_BUDGET=25
GOOGLE_REVIEW_SUMMARY_MAX_CONCURRENCY=1
GOOGLE_REVIEW_SUMMARY_LANGUAGE_CODE=en
GOOGLE_REVIEW_SUMMARY_REGION_CODE=US

# Explicit local LLM dish summary. Enable only for an approved private deployment.
LOCAL_DISH_SUMMARY_ENABLED=false
LOCAL_DISH_SUMMARY_MAX_REVIEWS=50
LOCAL_DISH_SUMMARY_MAX_REVIEW_CHARS=4000
LOCAL_DISH_SUMMARY_MAX_TOTAL_CHARS=20000
LOCAL_DISH_SUMMARY_MAX_REQUEST_BYTES=131072
LOCAL_DISH_SUMMARY_MAX_OUTPUT_CHARS=800
LOCAL_DISH_SUMMARY_LOG_CONTENT=false

# Set a long random value in production; signs opaque saved-review cursors.
REVIEW_CURSOR_SIGNING_KEY=development-review-cursor-signing-key

REVIEW_PROVIDER=serpapi
REVIEW_FALLBACK_PROVIDER=google_places

# OpenAI-compatible local LLM endpoint, e.g. http://100.x.y.z:8000/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
LLM_BATCH_MAX_CHARS=18000
# Development-only: log LLM filter candidate/selected review UUIDs. Never enable to log names or review text.
LLM_FILTER_DEBUG_LOGGING=false

# Compose defaults are suitable for local development. Override if needed.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
FRONTEND_ORIGIN=
LOG_LEVEL=INFO

# Tailscale-only production HTTPS. Cloudflare must use a DNS-only A record
# pointing APP_DOMAIN to TAILSCALE_IP; never point it at the Oracle public IP.
APP_DOMAIN=
TAILSCALE_IP=
ACME_EMAIL=
CLOUDFLARE_CREDENTIALS_FILE=/etc/real-reviews/cloudflare.ini
